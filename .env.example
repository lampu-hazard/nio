# ==============================================================================
# NIO Monorepo Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deployment & Docker Compose
# ------------------------------------------------------------------------------
# Docker Hub namespace used by docker-compose.yml image references
DOCKERHUB_NAMESPACE=your-dockerhub-username

# Image tag to pull/run ("latest" or Git commit SHA)
IMAGE_TAG=latest

# Node environment ("development" | "production" | "test")
NODE_ENV=production

# Server HTTP Port (default: 3001 locally, 3002 in docker-compose)
PORT=3002

# URLs for CORS and redirects
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3002

# ------------------------------------------------------------------------------
# 2. Database & Cache
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Prisma)
# Docker default: postgresql://nio:nio-server@localhost:5435/nio-db
DATABASE_URL=postgresql://nio:nio-server@localhost:5435/nio-db

# Redis connection string (Session cache & agent conversation memory)
REDIS_URL=redis://localhost:6379

# Express session encryption secret
SESSION_SECRET=change-this-to-a-secure-random-secret

# ------------------------------------------------------------------------------
# 3. Discord Application & Bot Credentials
# ------------------------------------------------------------------------------
# Discord Bot Token (from Discord Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=your-discord-bot-token

# Discord Application Client ID & Secret (OAuth2 & Slash Command registration)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Discord OAuth2 Redirect URI (Must match Developer Portal OAuth2 Redirects)
# Local: http://localhost:3001/auth/discord/callback (or via frontend proxy: http://localhost:3000/api/auth/discord/callback)
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Discord User ID of the Bot Owner (Required for Owner APIs and external MCP write approval)
OWNER_DISCORD_ID=your-discord-user-id

# ------------------------------------------------------------------------------
# 4. Storage (Cloudflare R2 / AWS S3 Compatible)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=nio
R2_PUBLIC_URL=https://cdn.example.com

# ------------------------------------------------------------------------------
# 5. Microservices & Internal Rust Engines
# ------------------------------------------------------------------------------
# Slowmode Engine HTTP URL
SLOWMODE_ENGINE_URL=http://localhost:3003

# Anomaly & Phishing Engine gRPC URL
ANOMALY_ENGINE_URL=localhost:50051

# Analytics Engine gRPC URL
ANALYTICS_ENGINE_URL=localhost:50053

# Sentinel Native Module Path (Optional, defaults to services/sentinel/nio-sentinel.node)
# SENTINEL_NATIVE_PATH=./services/sentinel/nio-sentinel.node

# ------------------------------------------------------------------------------
# 6. Discord AI Moderator Copilot & LLM Settings
# ------------------------------------------------------------------------------
DISCORD_AGENT_ENABLED=false
DISCORD_AGENT_PROVIDER=gemini
DISCORD_AGENT_MODEL=gemini-2.5-flash

# Comma-separated list of Discord User IDs permitted to prompt the AI agent (leave blank to allow guild admins)
DISCORD_AGENT_ALLOWED_USER_IDS=

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key

# OpenAI / OpenAI-Compatible (OpenRouter, Groq, Ollama, LocalAI, etc.)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# 32-byte hex key for encrypting dashboard-stored plugin API keys (openssl rand -hex 32)
PLUGIN_CREDENTIALS_ENCRYPTION_KEY=your-64-character-hex-encryption-key

# Search APIs for Copilot Live Research (Optional)
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# ------------------------------------------------------------------------------
# 7. Model Context Protocol (MCP) Configuration
# ------------------------------------------------------------------------------
# JSON array/dictionary of external MCP servers (see docs/superpowers/specs/2026-07-10-godmode-agent-tool-design.md)
# Example:
# MCP_SERVERS_JSON='[{"name":"filesystem","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","./allowed"],"tools":{"read_file":{"mode":"read"},"write_file":{"mode":"write"}}}]'
MCP_SERVERS_JSON=

# MCP Timeout & Buffer Limits (Optional)
# MCP_TIMEOUT_MS=15000
# MCP_MAX_OUTPUT_CHARS=16000

# ------------------------------------------------------------------------------
# 8. External Integrations (Optional)
# ------------------------------------------------------------------------------
# Tako Donation Integration User-Agent
TAKO_USER_AGENT=nio/1.0

# Kinetic Hosting panel URL override
# KINETIC_PANEL_URL=https://panel.kinetichosting.net
