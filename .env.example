# Docker Hub namespace used by docker-compose.yml image references.
# Example: lampuhazard or your Docker Hub username/organization.
DOCKERHUB_NAMESPACE=your-dockerhub-username

# Image tag to pull/run. Use "latest" for the most recent main build,
# or a Git commit SHA tag generated by GitHub Actions for rollback-safe deploys.
IMAGE_TAG=latest

# Discord AI Moderator Copilot Settings
DISCORD_AGENT_ENABLED=false
DISCORD_AGENT_PROVIDER=gemini
DISCORD_AGENT_MODEL=gemini-2.5-flash
DISCORD_AGENT_ALLOWED_USER_IDS=
GEMINI_API_KEY=

# Bot Owner Discord ID (Required for approving external MCP write operations)
OWNER_DISCORD_ID=

# Redis Cache & Agent Conversation Memory
REDIS_URL=redis://localhost:6379

# Model Context Protocol (MCP) Server Configurations
# JSON dictionary of trusted MCP servers loaded strictly from operator deployment environment.
# Each server specifies transport ("http" | "stdio"), tool allowlists, and safety mode ("read" | "write").
# - "read" tools execute autonomously within bounded limits.
# - "write" tools require human approval via interactive Discord action cards (restricted to OWNER_DISCORD_ID).
# Example:
# MCP_SERVERS_JSON='{"filesystem":{"transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","./allowed"],"tools":{"read_file":{"mode":"read"},"write_file":{"mode":"write"}}}}'
MCP_SERVERS_JSON=
